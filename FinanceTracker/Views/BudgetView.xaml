<UserControl x:Class="FinanceTracker.Views.BudgetView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="BudgetProgressBar" TargetType="{x:Type ProgressBar}">
            <Setter Property="Height" Value="7" />
            <Setter Property="Background" Value="{StaticResource BorderSubtleBrush}" />
            <Setter Property="Foreground" Value="{StaticResource AccentPurpleBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid ClipToBounds="True">
                            <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="4" />
                            <Border x:Name="PART_Indicator"
                                    HorizontalAlignment="Left"
                                    Background="{TemplateBinding Foreground}"
                                    CornerRadius="4" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SelectedRangePill" TargetType="{x:Type Button}" BasedOn="{StaticResource PillButton}">
            <Setter Property="Background" Value="{StaticResource AccentPurpleBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentPurpleBrush}" />
            <Setter Property="Foreground" Value="{StaticResource WhiteBrush}" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="28,24,28,28">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="16" />
                <RowDefinition Height="240" />
                <RowDefinition Height="18" />
                <RowDefinition Height="280" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Budgets"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource AccentPurpleBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SpentText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="6,0,16,0" />
                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource BorderBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding RemainingText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="6,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0">
                        <Button Content="1D" Style="{StaticResource PillButton}" Command="{Binding SelectRangeCommand}" CommandParameter="1D" Margin="0,0,6,0" Height="32" />
                        <Button Content="1W" Style="{StaticResource PillButton}" Command="{Binding SelectRangeCommand}" CommandParameter="1W" Margin="0,0,6,0" Height="32" />
                        <Button Content="1M" Style="{StaticResource SelectedRangePill}" Command="{Binding SelectRangeCommand}" CommandParameter="1M" Margin="0,0,6,0" Height="32" />
                        <Button Content="1Y" Style="{StaticResource PillButton}" Command="{Binding SelectRangeCommand}" CommandParameter="1Y" Height="32" />
                    </StackPanel>
                    <Button Content="Copy last month"
                            Style="{StaticResource DarkButton}"
                            Command="{Binding CopyLastMonthBudgetsCommand}"
                            Height="36"
                            Padding="14,0"
                            Margin="0,0,8,0" />
                    <Button Content="Manage budgets"
                            Style="{StaticResource AccentButton}"
                            Command="{Binding OpenBudgetDialogCommand}"
                            Height="36"
                            Padding="14,0" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource BaseCard}">
                <lvc:CartesianChart Series="{Binding BudgetSeries}"
                                    XAxes="{Binding BudgetXAxes}"
                                    YAxes="{Binding BudgetYAxes}"
                                    LegendPosition="Hidden"
                                    TooltipFindingStrategy="CompareOnlyX"
                                    TooltipBackgroundPaint="{Binding TooltipBackgroundPaint}"
                                    TooltipTextPaint="{Binding TooltipTextPaint}"
                                    TooltipTextSize="12"
                                    AnimationsSpeed="00:00:00.800"
                                    Background="Transparent"
                                    Margin="0,4,0,0" />
            </Border>

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource BaseCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="By account" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource TextPrimaryBrush}" />
                        <ItemsControl Grid.Row="2" ItemsSource="{Binding SpendingSources}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,18">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="8" />
                                            <RowDefinition Height="7" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="4" CornerRadius="2" Background="{Binding IconBrush}" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="3" Text="{Binding Fraction}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="4" Text="{Binding Pct, StringFormat={}{0:0}%}" Foreground="{StaticResource AccentPurpleBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                        <ProgressBar Grid.Row="2" Style="{StaticResource BudgetProgressBar}"
                                                     Maximum="100"
                                                     Value="{Binding Pct}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource BaseCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="14" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <TextBlock Text="Overspent categories" FontSize="13" Foreground="{StaticResource TextMutedBrush}" />
                        </Grid>

                        <Grid Grid.Row="2" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition Width="95" />
                                <ColumnDefinition Width="110" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="CATEGORY" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="EXPOSURES" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="2" Text="RISK LEVEL" Foreground="{StaticResource TextMutedBrush}" FontSize="11" FontWeight="SemiBold" />
                        </Grid>

                        <ItemsControl Grid.Row="3" ItemsSource="{Binding OverspentCategories}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Height="38">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition />
                                            <ColumnDefinition Width="95" />
                                            <ColumnDefinition Width="110" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Category}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Exposures}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center" />
                                        <ItemsControl Grid.Column="2" ItemsSource="{Binding RiskDots}" VerticalAlignment="Center">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Ellipse Width="9" Height="9" Fill="{Binding Fill}" Margin="0,0,7,0" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <ItemsControl Grid.Row="6" ItemsSource="{Binding BudgetCards}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource BaseCard}" Width="252" MinHeight="176" Margin="0,0,14,14">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="28" Height="28" CornerRadius="8" Background="{Binding IconBrush}">
                                                <TextBlock Text="{Binding IconGlyph}"
                                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                                           Foreground="{StaticResource WhiteBrush}"
                                                           FontSize="13"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                            </Border>
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Text="{Binding SpentLimit}" FontSize="20" FontWeight="Bold" Margin="0,18,0,12" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsOverspent}" Value="True">
                                                        <Setter Property="Foreground" Value="#EF4444" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <ProgressBar Style="{StaticResource BudgetProgressBar}" Value="{Binding ProgressValue}" Maximum="100" Foreground="{Binding ProgressBrush}" />
                                    <TextBlock Text="{Binding DaysLeftText}" Foreground="{StaticResource TextMutedBrush}" FontSize="12" Margin="0,12,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            <Grid Grid.RowSpan="7"
                  Background="#8C000000"
                  Visibility="{Binding IsBudgetDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
                  Panel.ZIndex="50">
                <Border Width="420"
                        Background="{StaticResource CardBgBrush}"
                        CornerRadius="16"
                        Padding="24"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="16" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Monthly budgets"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   FontSize="16"
                                   FontWeight="SemiBold" />
                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding BudgetEditorRows}"
                                  Style="{StaticResource DarkDataGrid}"
                                  AutoGenerateColumns="False"
                                  MaxHeight="320">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="*" IsReadOnly="True" />
                                <DataGridTextColumn Header="Limit" Binding="{Binding MonthlyLimit, StringFormat=F2}" Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <Grid Grid.Row="4">
                            <Button Content="Cancel"
                                    Style="{StaticResource DarkButton}"
                                    Width="120"
                                    Height="38"
                                    Command="{Binding CloseBudgetDialogCommand}" />
                            <Button Content="Save"
                                    Style="{StaticResource AccentButton}"
                                    Width="120"
                                    Height="38"
                                    HorizontalAlignment="Right"
                                    Command="{Binding SaveBudgetsCommand}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </ScrollViewer>
</UserControl>
